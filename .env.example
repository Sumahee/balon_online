# =========================================================
# BARON ONLINE - 환경 변수 설정 템플릿 (.env.example)
# =========================================================
# 이 파일을 복사하여 '.env.local' 또는 '.env'로 이름을 변경한 뒤
# 실제 발급받은 Turso 키를 입력해 주세요.

# 1. Turso (SQLite 호환 엣지 데이터베이스)
# Turso 웹 콘솔(https://turso.tech) 또는 CLI(turso db show [DB명] --url)에서 확인
TURSO_DATABASE_URL="libsql://baron-online-db-yourname.turso.io"

# Turso DB 토큰 (turso db tokens create [DB명])
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# 2. 파일 스토리지 (선택 사항: Cloudinary 또는 Supabase Storage)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_API_KEY="your_api_key"
# CLOUDINARY_API_SECRET="your_api_secret"

# 3. Next.js 환경 설정
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
