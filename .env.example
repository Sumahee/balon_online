# =========================================================
# BARON ONLINE - 환경 변수 설정 템플릿 (.env.example)
# =========================================================
# 이 파일을 복사하여 '.env.local' 또는 '.env'로 이름을 변경한 뒤
# 실제 발급받은 Turso 키를 입력해 주세요.

# 1. Turso (SQLite 호환 엣지 데이터베이스)
# Turso 웹 콘솔(https://turso.tech) 또는 CLI(turso db show [DB명] --url)에서 확인
TURSO_DATABASE_URL="libsql://baron-online-db-yourname.turso.io"

# Turso DB 토큰 (turso db tokens create [DB명])
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# 2. 대용량 파일 스토리지 (Cloudflare R2 - 트래픽 비용 $0 무제한 오브젝트 스토리지)
# Cloudflare 대시보드 -> R2 오브젝트 스토리지에서 버킷 및 API 토큰 발급
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="balononline"
# Photos are served through the authenticated app API; a public bucket URL is not required.

# 3. Next.js 환경 설정
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"


# Required: generate a private random session signing key; never commit the real value.
JWT_SECRET="replace_with_a_long_random_private_secret"

# Drawing handoff destination (use http://localhost:5173 for local paired testing).
BARON_DESIGN_URL="https://balon-design.vercel.app"
